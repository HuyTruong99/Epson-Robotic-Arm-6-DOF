Function main

    String cmd$
    Integer errCode

    OnErr GoTo ErrorHandler

    ' ==========================================
    ' NETWORK SERVER
    ' ==========================================

    SetNet #201, "192.168.1.10", 2000, CRLF, NONE, 0

    OpenNet #201 As Server

    Print "WAITING FOR PYTHON..."

    WaitNet #201

    Print "PYTHON CONNECTED"


    ' ==========================================
    ' ROBOT SETTINGS
    ' ==========================================

    Motor On

    ' Keep low power during testing
    Power Low

    ' Slow enough to clearly observe movement
    SpeedS 10
    AccelS 20, 20

    Print "SERVER READY"


    ' ==========================================
    ' MAIN LOOP
    ' ==========================================

    Do

        If ChkNet(201) > 0 Then

            Line Input #201, cmd$

            Print "Received: ", cmd$


            ' ==================================
            ' GET CURRENT POSITION
            ' ==================================

            If cmd$ = "POS" Then

                P99 = Here

                Print "CURRENT POSITION"
                Print "X = ", CX(P99)
                Print "Y = ", CY(P99)
                Print "Z = ", CZ(P99)

                Print #201, "POS,", CX(P99), ",", CY(P99), ",", CZ(P99), ",", CU(P99), ",", CV(P99), ",", CW(P99)


            ' ==================================
            ' LEFT = -100 MM X
            ' ==================================

            ElseIf cmd$ = "LEFT" Then

                P99 = Here

                Print "================================"
                Print "LEFT COMMAND RECEIVED"
                Print "Current X = ", CX(P99)
                Print "Target X  = ", CX(P99) - 100
                Print "================================"

                ' Check target BEFORE movement
                If TargetOK(P99 -X(100)) Then

                    Print "TargetOK = TRUE"
                    Print "MOVING LEFT -100 MM"

                    Print #201, "START,LEFT,-100"

                    ' Move 100 mm in negative X
                    Move P99 -X(100)

                    ' Read new position
                    P99 = Here

                    Print "LEFT MOVE FINISHED"
                    Print "New X = ", CX(P99)
                    Print "New Y = ", CY(P99)
                    Print "New Z = ", CZ(P99)

                    Print #201, "DONE,", CX(P99), ",", CY(P99), ",", CZ(P99), ",", CU(P99), ",", CV(P99), ",", CW(P99)

                Else

                    Print "*******************************"
                    Print "LEFT -100 MM NOT REACHABLE"
                    Print "ROBOT DID NOT MOVE"
                    Print "*******************************"

                    Print #201, "TARGET_NOT_OK,LEFT"

                EndIf


            ' ==================================
            ' RIGHT = +100 MM X
            ' ==================================

            ElseIf cmd$ = "RIGHT" Then

                P99 = Here

                Print "================================"
                Print "RIGHT COMMAND RECEIVED"
                Print "Current X = ", CX(P99)
                Print "Target X  = ", CX(P99) + 100
                Print "================================"

                ' Check target BEFORE movement
                If TargetOK(P99 +X(100)) Then

                    Print "TargetOK = TRUE"
                    Print "MOVING RIGHT +100 MM"

                    Print #201, "START,RIGHT,100"

                    ' Move 100 mm in positive X
                    Move P99 +X(100)

                    ' Read new position
                    P99 = Here

                    Print "RIGHT MOVE FINISHED"
                    Print "New X = ", CX(P99)
                    Print "New Y = ", CY(P99)
                    Print "New Z = ", CZ(P99)

                    Print #201, "DONE,", CX(P99), ",", CY(P99), ",", CZ(P99), ",", CU(P99), ",", CV(P99), ",", CW(P99)

                Else

                    Print "*******************************"
                    Print "RIGHT +100 MM NOT REACHABLE"
                    Print "ROBOT DID NOT MOVE"
                    Print "*******************************"

                    Print #201, "TARGET_NOT_OK,RIGHT"

                EndIf


            ' ==================================
            ' UNKNOWN COMMAND
            ' ==================================

            Else

                Print "UNKNOWN COMMAND: ", cmd$

                Print #201, "UNKNOWN,", cmd$

            EndIf

        EndIf

        Wait 0.05

    Loop


    Exit Function


' ==========================================
' ERROR HANDLER
' ==========================================

ErrorHandler:

    errCode = Err

    Print "*******************************"
    Print "ROBOT ERROR"
    Print "Error Code = ", errCode
    Print "Error Message = ", ErrMsg$(errCode)
    Print "*******************************"

    Print #201, "ERROR,", errCode, ",", ErrMsg$(errCode)

Fend
