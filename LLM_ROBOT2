import socket
import threading
import csv
import os
from datetime import datetime


# ==========================================================
# ROBOT CONNECTION
# ==========================================================

ROBOT_IP = "192.168.1.6"
PORT = 2000


# ==========================================================
# CSV FILE
# ==========================================================

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
CSV_FILE = os.path.join(SCRIPT_DIR, "robot_position.csv")


# ==========================================================
# GLOBAL VARIABLES
# ==========================================================

sock = None
running = True


# ==========================================================
# CREATE CSV FILE
# ==========================================================

def initialize_csv():

    if not os.path.exists(CSV_FILE):

        with open(
            CSV_FILE,
            "w",
            newline="",
            encoding="utf-8"
        ) as file:

            writer = csv.writer(file)

            writer.writerow([
                "timestamp",
                "X_mm",
                "Y_mm",
                "Z_mm",
                "U_deg",
                "V_deg",
                "W_deg"
            ])

    print(f"\nCSV file:")
    print(CSV_FILE)


# ==========================================================
# SAVE POSITION
# ==========================================================

def save_position(values):

    try:

        x, y, z, u, v, w = values

        timestamp = datetime.now().strftime(
            "%Y-%m-%d %H:%M:%S.%f"
        )[:-3]

        with open(
            CSV_FILE,
            "a",
            newline="",
            encoding="utf-8"
        ) as file:

            writer = csv.writer(file)

            writer.writerow([
                timestamp,
                x,
                y,
                z,
                u,
                v,
                w
            ])

    except Exception as error:

        print("CSV ERROR:", error)


# ==========================================================
# PROCESS MESSAGE FROM RC+
# ==========================================================

def process_robot_message(message):

    message = message.strip()

    if not message:
        return

    # ------------------------------------------
    # Position message
    # ------------------------------------------

    if message.startswith("POS,"):

        try:

            parts = message.split(",")

            if len(parts) >= 7:

                values = [
                    float(parts[1]),
                    float(parts[2]),
                    float(parts[3]),
                    float(parts[4]),
                    float(parts[5]),
                    float(parts[6])
                ]

                save_position(values)

                print(
                    f"\r"
                    f"X={values[0]:8.3f}  "
                    f"Y={values[1]:8.3f}  "
                    f"Z={values[2]:8.3f}  "
                    f"U={values[3]:8.3f}  "
                    f"V={values[4]:8.3f}  "
                    f"W={values[5]:8.3f}",
                    end="",
                    flush=True
                )

        except Exception as error:

            print("\nPOSITION PARSE ERROR:", error)

        return


    # ------------------------------------------
    # Other RC+ messages
    # ------------------------------------------

    print(f"\nRC+: {message}")


# ==========================================================
# RECEIVE DATA CONTINUOUSLY
# ==========================================================

def receive_robot_data():

    global running

    buffer = ""

    while running:

        try:

            data = sock.recv(4096)

            if not data:

                print("\nRobot disconnected.")
                running = False
                break

            buffer += data.decode(
                "utf-8",
                errors="ignore"
            )

            while "\n" in buffer:

                line, buffer = buffer.split("\n", 1)

                line = line.replace("\r", "")

                process_robot_message(line)

        except ConnectionResetError:

            print("\nRobot closed connection.")

            running = False
            break

        except Exception as error:

            if running:
                print("\nReceive error:", error)

            break


# ==========================================================
# SEND COMMAND
# ==========================================================

def send_command(command):

    try:

        message = command + "\r\n"

        sock.sendall(
            message.encode("utf-8")
        )

        print(f"\n\nCOMMAND -> {command}")

    except Exception as error:

        print("\nSEND ERROR:", error)


# ==========================================================
# SIMPLE ENGLISH COMMAND INTERPRETER
# ==========================================================

def understand_command(text):

    text = text.lower().strip()


    # ------------------------------------------------------
    # OPEN GRIPPER
    # ------------------------------------------------------

    if (
        "open" in text
        and (
            "gripper" in text
            or "hand" in text
            or "finger" in text
        )
    ):

        return "GRIP_OPEN"


    # ------------------------------------------------------
    # CLOSE / GRAB
    # ------------------------------------------------------

    if (
        "close" in text
        or "grab" in text
        or "grip" in text
        or "pick up" in text
    ):

        if (
            "gripper" in text
            or "hand" in text
            or "object" in text
            or "it" in text
            or "grab" in text
            or "grip" in text
            or "pick up" in text
        ):

            return "GRIP_CLOSE"


    # ------------------------------------------------------
    # RIGHT / +X
    # ------------------------------------------------------

    if (
        "right" in text
        or "+x" in text
        or "positive x" in text
    ):

        return "MOVE_X_100"


    # ------------------------------------------------------
    # LEFT / -X
    # ------------------------------------------------------

    if (
        "left" in text
        or "-x" in text
        or "negative x" in text
    ):

        return "MOVE_X_MINUS_100"


    # ------------------------------------------------------
    # CURRENT POSITION
    # ------------------------------------------------------

    if (
        "position" in text
        or "coordinate" in text
        or "where" in text
    ):

        return "POS"


    # ------------------------------------------------------
    # PICK TEST
    # ------------------------------------------------------

    if text == "pick test":

        return "PICK_TEST"


    # ------------------------------------------------------
    # Exact RC+ command
    # ------------------------------------------------------

    exact_commands = [
        "GRIP_OPEN",
        "GRIP_CLOSE",
        "MOVE_X_100",
        "MOVE_X_MINUS_100",
        "POS",
        "PICK_TEST"
    ]

    upper_text = text.upper()

    if upper_text in exact_commands:

        return upper_text


    return None


# ==========================================================
# MAIN PROGRAM
# ==========================================================

def main():

    global sock
    global running

    initialize_csv()

    print("\n======================================")
    print(" EPSON RC+ ROBOT + GRIPPER CONTROL")
    print("======================================")

    print(f"\nRobot IP : {ROBOT_IP}")
    print(f"Port     : {PORT}")

    print("\nConnecting to Epson robot...")


    # ------------------------------------------------------
    # CREATE SOCKET
    # ------------------------------------------------------

    sock = socket.socket(
        socket.AF_INET,
        socket.SOCK_STREAM
    )

    sock.settimeout(10)


    # ------------------------------------------------------
    # CONNECT
    # ------------------------------------------------------

    try:

        sock.connect(
            (ROBOT_IP, PORT)
        )

        sock.settimeout(None)

    except Exception as error:

        print("\nCould not connect to Epson robot.")

        print("\nMake sure:")
        print("RC+ program is RUNNING")
        print("RC+ says WAITING FOR PYTHON...")
        print("Ethernet is connected")
        print("Robot IP is 192.168.1.6")
        print("Port is 2000")

        print("\nError:")
        print(error)

        return


    print("\nCONNECTED TO EPSON ROBOT")


    # ------------------------------------------------------
    # START RECEIVER THREAD
    # ------------------------------------------------------

    receiver = threading.Thread(
        target=receive_robot_data,
        daemon=True
    )

    receiver.start()


    # ------------------------------------------------------
    # COMMAND LOOP
    # ------------------------------------------------------

    print("\nYou can type English commands such as:")

    print("""
    open the gripper
    close the gripper
    grab the object
    move right
    move left
    show position

    or exact commands:

    GRIP_OPEN
    GRIP_CLOSE
    MOVE_X_100
    MOVE_X_MINUS_100
    POS

    Type EXIT to stop.
    """)


    while running:

        try:

            user_text = input("\nYOU > ")

            if user_text.lower().strip() in [
                "exit",
                "quit",
                "stop program"
            ]:

                running = False
                break


            robot_command = understand_command(
                user_text
            )


            if robot_command is None:

                print(
                    "I do not understand that command."
                )

                continue


            print(
                f"INTERPRETED AS -> {robot_command}"
            )

            send_command(
                robot_command
            )


        except KeyboardInterrupt:

            running = False
            break


    # ------------------------------------------------------
    # CLOSE CONNECTION
    # ------------------------------------------------------

    print("\nClosing connection...")

    try:
        sock.shutdown(socket.SHUT_RDWR)
    except Exception:
        pass

    sock.close()

    print("Program stopped.")

    print("\nRobot position data saved at:")

    print(CSV_FILE)


# ==========================================================
# START
# ==========================================================

if __name__ == "__main__":

    main()
